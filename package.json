{
  "name": "budget-beacon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "firefox": "firefox-esr",
    "preview": "node scripts/preview.cjs",
    "test:firefox": "node scripts/firefox-smoke.cjs",
    "firefox:dev": "web-ext run --source-dir extension",
    "install:plan": "python3 scripts/install-esr.py --allow-unsigned",
    "build:safari": "node scripts/build-safari.cjs",
    "package:safari": "node scripts/package-safari.cjs"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
